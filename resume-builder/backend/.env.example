# Copy this file to .env and fill in your own key
ANTHROPIC_API_KEY=your_api_key_here

# Set to true to bypass real Claude calls and use canned test data instead
MOCK_MODE=false

# Comma-separated extra origins allowed to call this API (production frontend domain).
# localhost:5173 and localhost:3000 are always allowed for local dev.
ALLOWED_ORIGINS=https://yourdomain.com,https://your-project.pages.dev
